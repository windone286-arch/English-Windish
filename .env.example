# ==============================================================================
# English-Windish 环境配置
#
# 使用方式：
#   1. 复制本文件为 .env（同一目录）
#   2. 填入你自己的 API Key
#   3. .env 已被 .gitignore 排除，不会被上传到 GitHub
#
# 重要：本项目需要「视觉」和「文本」两类模型，可以来自不同服务商。
#       DeepSeek 推理能力强，但**没有视觉模型**，所以图片识别必须用别家。
# ==============================================================================

# ------------------------------------------------------------------------------
# 视觉服务商（负责图片识别）
# 可选：dashscope（阿里通义千问）/ zhipu（智谱 GLM）
# 不支持 deepseek —— 它没有视觉模型
# ------------------------------------------------------------------------------
VISION_PROVIDER=dashscope

# 阿里通义千问
# 申请地址：https://bailian.console.aliyun.com/
# 新用户有免费额度，qwen-vl-max 识别质量很好
DASHSCOPE_API_KEY=sk-your-key-here

# 智谱 GLM（备选，同样有免费额度）
# 申请地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# ------------------------------------------------------------------------------
# 文本服务商（负责语法分析、单词精讲）
# 可选：deepseek / dashscope / zhipu
# ------------------------------------------------------------------------------
TEXT_PROVIDER=deepseek

# DeepSeek
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 如果用的是第三方中转站，填它的地址（留空则用官方地址）
# 例如：https://your-proxy.com/v1
DEEPSEEK_BASE_URL=

# ------------------------------------------------------------------------------
# 模型名称
# 留空则用代码里的默认值（按服务商自动匹配）
# ------------------------------------------------------------------------------
# 视觉模型：qwen-vl-max（通义）/ glm-4v-plus（智谱）
VISION_MODEL=qwen-vl-max

# 文本模型：deepseek-chat（快、便宜）/ deepseek-reasoner（强推理、慢、贵）
TEXT_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 运行配置
# ------------------------------------------------------------------------------
# 是否打印详细进度。开发时设 true，正式部署设 false
DEBUG=true
