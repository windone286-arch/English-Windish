# ===== 大模型 API 配置 =====
# 使用方式：复制本文件为 .env，然后填入你自己的真实 key
# 注意：.env 已被 .gitignore 排除，不会上传到 GitHub

# --- 阿里通义千问（推荐，有免费额度，支持图片输入）---
DASHSCOPE_API_KEY=sk-your-key-here

# --- 智谱 GLM（备选）---
ZHIPU_API_KEY=your-key-here

# --- DeepSeek（备选，文本处理强，视觉能力一般）---
DEEPSEEK_API_KEY=your-key-here

# ===== 应用配置 =====
# 使用哪个模型服务：dashscope / zhipu / deepseek
LLM_PROVIDER=dashscope

# 视觉模型名称（用于图片识别）
VISION_MODEL=qwen-vl-max

# 文本模型名称（用于语法分析与单词精讲）
TEXT_MODEL=qwen-plus

# 调试模式
DEBUG=true
