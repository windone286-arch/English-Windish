# 缓存与临时文件
.cache/
*.log
temp/
tmp/

# ---------------------------------------------------------------------------
# 隐私保护：用户提供的图片与生成的报告一律不入库
#
# 理由：用户上传的可能是私人试卷、成绩单、笔记。
# 一旦提交到公开仓库，即使后续删除，历史记录里仍然可以找回。
# 所以从源头拦截，而不是靠事后清理。
# ---------------------------------------------------------------------------
data/uploads/
data/raw/
data/reports/

# samples 目录只保留用于演示的示例图片，其余一律忽略
data/samples/*
!data/samples/sample_article.png
!data/samples/.gitkeep

# SQLite 数据库（运行时生成）
*.db
*.sqlite
*.sqlite3

# ===== Jupyter =====
.ipynb_checkpoints/
